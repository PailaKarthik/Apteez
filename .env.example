# =============================================================================
# ApteeZ environment configuration
# Copy this file to `.env` at the repository root for local development:
#   copy .env.example .env   (Windows PowerShell)
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3001
APP_VERSION=0.1.0
LOG_LEVEL=info

# Public URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Database (PostgreSQL via docker compose) ------------------------------
DATABASE_URL=postgresql://apteez:apteez@localhost:5432/apteez?schema=public

# --- Redis (via docker compose) --------------------------------------------
REDIS_URL=redis://localhost:6379

# --- HTTP ------------------------------------------------------------------
# Comma-separated allowlist for CORS. The web app origin must be listed.
CORS_ORIGINS=http://localhost:3000
# Trust proxy hops (set to 1+ behind a load balancer, 0 for direct).
TRUST_PROXY=1

# --- Rate limiting (global defaults) ---------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# --- Cookies / sessions ----------------------------------------------------
# Signed-cookie secret used by cookie-parser.
COOKIE_SECRET=change-me-in-production
# Opaque session cookie name + absolute lifetime (sliding refresh while active).
SESSION_COOKIE_NAME=apteez_session
SESSION_TTL_SECONDS=1209600

# --- Auth rate limits (Redis-backed, per IP / per account) -----------------
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
LOGIN_MAX_ATTEMPTS=8
LOGIN_ATTEMPT_WINDOW_SECONDS=600
# Practice answer-submission limit (per IP).
PRACTICE_RATE_LIMIT=60
PRACTICE_RATE_WINDOW_SECONDS=60
# Challenge matchmaking rate limit (per IP).
CHALLENGE_RATE_LIMIT=30
CHALLENGE_RATE_WINDOW_SECONDS=60

# --- Google OAuth (optional; app runs fine without it) ---------------------
# When unset, /api/v1/auth/google returns OAUTH_NOT_CONFIGURED (503) and the
# rest of the platform works normally. Sessions are opaque tokens in Redis —
# the client only ever holds the HTTP-only cookie.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# --- Object storage --------------------------------------------------------
# Provider selection: "local" (filesystem, local dev) or "s3" (any
# S3-compatible store such as AWS S3 or Cloudflare R2).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.data/storage
# S3/R2 settings below are provider-specific and only required when
# STORAGE_PROVIDER=s3.
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=apteez-dev
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- Web app (also see apps/web/.env.example) ------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
