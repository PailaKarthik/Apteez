# =============================================================================
# ApteeZ environment configuration
# Copy this file to `.env` at the repository root for local development:
#   copy .env.example .env   (Windows PowerShell)
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3001
APP_VERSION=0.1.0
LOG_LEVEL=info

# Public URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Database (Neon PostgreSQL — permanent source of truth) ---------------
# Neon is the ONLY permanent database. Redis never holds permanent data.
#
# Two URLs (Prisma 6 `url` vs `directUrl`):
#   DATABASE_URL — RUNTIME pooled endpoint (Neon "Pooled connection" string:
#     hostname ends in `-pooler`, and MUST include `?pgbouncer=true` so
#     Prisma disables prepared statements on the pooler).
#     e.g. postgresql://USER:PASSWORD@ep-xyz-pooler.REGION.aws.neon.tech/apteez?sslmode=require&pgbouncer=true&connection_limit=10
#   DIRECT_URL   — MIGRATIONS/introspection direct endpoint (Neon "Direct
#     connection" string, no pooler, no pgbouncer flag). `migrate deploy`
#     uses this automatically; the app never uses it at runtime.
#     e.g. postgresql://USER:PASSWORD@ep-xyz.REGION.aws.neon.tech/apteez?sslmode=require
#
# Branches (Neon dashboard → Branches; one per environment, never shared):
#   development → Neon `dev` branch/database (local `pnpm dev` points here)
#   test        → Neon `test` branch or a local throwaway (e2e guard still
#                 refuses anything but a `*_test` database)
#   staging     → isolated Neon `staging` branch (seeded ONLY by
#                 `db:seed:staging`, which refuses production + non-demo DBs)
#   production  → Neon `main`/production database (migrate deploy only,
#                 backups + PITR on, seeds refuse NODE_ENV=production)
#
# pgvector ships with Neon: the RAG migration enables it idempotently
# (`CREATE EXTENSION IF NOT EXISTS "vector"`). Verify after migrating:
#   SELECT * FROM pg_extension WHERE extname = 'vector';
#
# Local fallback (no Neon yet): point BOTH variables at docker Postgres
# (`pnpm docker:up` still provides Redis; the postgres service was removed
# from compose — see infrastructure/docker/docker-compose.yml).
# DATABASE_URL=postgresql://apteez:apteez@localhost:5432/apteez?schema=public
# DIRECT_URL=postgresql://apteez:apteez@localhost:5432/apteez?schema=public
DATABASE_URL=
DIRECT_URL=

# --- Redis (via docker compose) --------------------------------------------
REDIS_URL=redis://localhost:6379

# --- HTTP ------------------------------------------------------------------
# Comma-separated allowlist for CORS. The web app origin must be listed.
CORS_ORIGINS=http://localhost:3000
# Trust proxy hops (set to 1+ behind a load balancer, 0 for direct).
TRUST_PROXY=1

# --- Rate limiting (global defaults) ---------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# --- Cookies / sessions ----------------------------------------------------
# Signed-cookie secret used by cookie-parser.
COOKIE_SECRET=change-me-in-production
# Opaque session cookie name + absolute lifetime (sliding refresh while active).
SESSION_COOKIE_NAME=apteez_session
SESSION_TTL_SECONDS=1209600

# --- Auth rate limits (Redis-backed, per IP / per account) -----------------
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60
LOGIN_MAX_ATTEMPTS=8
LOGIN_ATTEMPT_WINDOW_SECONDS=600
# Practice answer-submission limit (per IP).
PRACTICE_RATE_LIMIT=60
PRACTICE_RATE_WINDOW_SECONDS=60
# Challenge matchmaking rate limit (per IP).
CHALLENGE_RATE_LIMIT=30
CHALLENGE_RATE_WINDOW_SECONDS=60
# Timed challenge matches: minutes per run (1–10). Endless questions until
# the clock expires; highest score wins. Change + restart the API to apply.
CHALLENGE_DURATION_MINUTES=2
# Solo fallback: seconds of searching before a lone player gets an unrated
# solo run vs the house bot instead of waiting forever.
CHALLENGE_SOLO_WAIT_SECONDS=15

# --- Google OAuth (optional; app runs fine without it) ---------------------
# When unset, the Google buttons send users back to login with an inline
# "not available" message and the rest of the platform works normally.
# Sessions are opaque tokens in Redis — the client only ever holds the
# HTTP-only cookie.
#
# Setup (2 min, Google Cloud Console):
#   1. APIs & Services → Credentials → Create Credentials → OAuth client ID
#      (type: Web application).
#   2. Under "Authorized redirect URIs" add EXACTLY this value:
#        http://localhost:3001/api/v1/auth/google/callback
#      (production: https://<your-api-domain>/api/v1/auth/google/callback)
#   3. Paste the client ID/secret below and restart the API.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# --- Email OTP verification (Resend, free 100/day) -------------------------
# Without these, signup/login keep working — OTP sends are skipped and the
# in-app banner explains verification is unavailable. To enable:
#   1. Create a free account at https://resend.com → API Keys → create key.
#   2. Paste it below and restart the API.
#   3. EMAIL_FROM: free testing works immediately with onboarding@resend.dev,
#      BUT Resend then delivers only to your own account email. To mail any
#      user, verify your own domain in Resend (Domains → Add) and set e.g.
#      EMAIL_FROM="ApteeZ <verify@yourdomain.com>".
# RESEND_API_KEY=
# EMAIL_FROM=ApteeZ <onboarding@resend.dev>

# --- Object storage --------------------------------------------------------
# Provider selection: "local" (filesystem, local dev) or "s3" (any
# S3-compatible store such as AWS S3 or Cloudflare R2).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.data/storage
# S3/R2 settings below are provider-specific and only required when
# STORAGE_PROVIDER=s3.
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=apteez-dev
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# --- Error tracking (optional; app runs fine without it) -------------------
# When unset, Sentry is never initialized on either app. Values below are
# placeholders, never real credentials.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_DSN=

# --- AI providers (optional; features degrade gracefully without them) -----
# The AI application layer reads these only when an AI feature is invoked.
# Never commit real keys; production injects them via secrets management.
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_BASE_URL=
# Per-user daily AI request budget per feature (Redis counter, fail-open).
# Set to 0 to effectively disable AI features without redeploying.
AI_DAILY_LIMIT=50

# --- Release identity (injected by CI/deploy; never secrets) ---------------
# Baked into the API image via --build-arg in CI; ECS/task env otherwise.
# Powers the commit/tag fields on /health so operators see which build runs.
# GIT_SHA=
# RELEASE_TAG=

# --- Feature flags (all default ON; see docs/feature-flags.md) -------------
# Base switches: true/false/1/0 (unset = on). Optional _ROLLOUT vars enable a
# deterministic percentage rollout (0-100) bucketed by user id. Changing any
# flag is a redeploy. There is intentionally no Weekly Targets flag — the
# surface does not exist yet and stays "Coming Soon" in the UI.
# FEATURE_AI_PERFORMANCE_COACH=true
# FEATURE_AI_PERFORMANCE_COACH_ROLLOUT=
# FEATURE_AI_SIMILAR_PROBLEMS=true
# FEATURE_AI_SIMILAR_PROBLEMS_ROLLOUT=
# FEATURE_AI_CONTRIBUTION_REVIEW=true
# FEATURE_AI_CONTRIBUTION_REVIEW_ROLLOUT=
# FEATURE_REWARDS_REDEMPTION=true
# FEATURE_REWARDS_REDEMPTION_ROLLOUT=
# FEATURE_PUBLIC_EVENTS=true
# FEATURE_PUBLIC_EVENTS_ROLLOUT=
# FEATURE_COMMUNITY_CONTRIBUTIONS=true
# FEATURE_COMMUNITY_CONTRIBUTIONS_ROLLOUT=

# --- Web app (also see apps/web/.env.example) ------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Canonical site origin for sitemap/robots/OG metadata (production: Vercel URL).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
