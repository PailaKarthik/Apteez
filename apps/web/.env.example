# Web app environment. Copy to `.env.local` (gitignored) for local runs.
# NEXT_PUBLIC_API_URL is inlined into the client bundle — never put secrets here.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Canonical site origin for sitemap/robots/OG metadata (production: Vercel URL).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
