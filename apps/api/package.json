{
  "name": "@apteez/api",
  "version": "0.1.0",
  "private": true,
  "description": "ApteeZ NestJS REST API (authoritative backend for web + future mobile)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest --config jest.config.json",
    "test:e2e": "jest --config test/jest-e2e.json"
  },
  "dependencies": {
    "@apteez/config": "workspace:*",
    "@apteez/database": "workspace:*",
    "@apteez/types": "workspace:*",
    "@apteez/validation": "workspace:*",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/throttler": "^6.1.0",
    "@nestjs/websockets": "^10.4.22",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.6",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@apteez/eslint-config": "workspace:*",
    "@apteez/tsconfig": "workspace:*",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.16.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.12.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.6.3"
  }
}
