{
  "name": "apteez",
  "version": "0.1.0",
  "private": true,
  "description": "ApteeZ — competitive aptitude ecosystem (monorepo)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,mdx,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,mdx,yml,yaml,css}\"",
    "db:generate": "pnpm --filter @apteez/database db:generate",
    "db:migrate": "pnpm --filter @apteez/database db:migrate",
    "db:deploy": "pnpm --filter @apteez/database db:deploy",
    "db:seed": "pnpm --filter @apteez/database db:seed",
    "db:seed:staging": "pnpm --filter @apteez/database db:seed:staging",
    "db:studio": "pnpm --filter @apteez/database db:studio",
    "smoke:prod": "node scripts/smoke/prod-smoke.mjs",
    "deploy:verify": "node scripts/deploy/verify-deploy.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "multer": "2.4.0",
      "postcss": "8.5.28",
      "lodash": "4.18.1"
    }
  }
}
